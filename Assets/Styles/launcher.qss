QWidget#msgCard {
    background-color: rgba(22, 22, 22, 240);
    border: 2px solid $theme_color;
    border-radius: 14px;
}

QLabel#messageLabel {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
    background: transparent;
    border: none;
}

QPushButton#dialogPrimaryButton {
    background-color: $theme_color;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: bold;
    padding: 10px 20px;
    border-radius: 8px;
    border: none;
}

QPushButton#dialogPrimaryButton:hover,
QPushButton#dialogPrimaryButton:focus {
    background-color: rgba(255, 255, 255, 30);
    border: 1px solid $theme_color;
}

QPushButton#dialogSecondaryButton {
    background-color: rgba(45, 45, 45, 200);
    color: #FFFFFF;
    font-size: 14px;
    font-weight: bold;
    padding: 10px 20px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 30);
}

QPushButton#dialogSecondaryButton:hover,
QPushButton#dialogSecondaryButton:focus {
    background-color: rgba(65, 65, 65, 220);
    border: 1px solid rgba(255, 255, 255, 60);
}

QDialog#applicationEditorDialog {
    background-color: #222222;
    color: #FFFFFF;
}

QPushButton#applicationSaveButton {
    background-color: $theme_color;
    color: #FFFFFF;
    padding: 8px;
    font-weight: bold;
}

QLabel#launcherBackground {
    background-color: #141414;
}

QWidget#contentWidget {
    background-color: $background_color;
}

QWidget#homePage,
QWidget#settingsPage {
    background: transparent;
}

QMenu#powerMenu {
    background-color: #222222;
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 30);
    padding: 6px;
    font-size: 14px;
}

QMenu#powerMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
    background: transparent;
}

QMenu#powerMenu::item:selected {
    background-color: $theme_color;
    color: #FFFFFF;
}

QLabel#launcherTitle {
    color: #FFFFFF;
    font-size: 38px;
    font-weight: bold;
    background: transparent;
}

QLabel#launcherClock {
    color: #AAAAAA;
    font-size: 15px;
    font-weight: bold;
    background: transparent;
}

QPushButton#launcherBackButton {
    background-color: rgba(35, 35, 35, 160);
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
    padding: 10px 24px;
    border-radius: 12px;
    border: 2px solid rgba(255, 255, 255, 30);
}

QPushButton#launcherBackButton:hover,
QPushButton#launcherBackButton:focus {
    color: #FFFFFF;
    background-color: rgba(60, 60, 60, 210);
    border: 2px solid $theme_color;
}

QPushButton#launcherSettingsButton {
    background-color: rgba(35, 35, 35, 140);
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
    padding: 14px 28px;
    border-radius: $border_radius;
    border: 2px solid rgba(255, 255, 255, 25);
}

QPushButton#launcherSettingsButton:hover,
QPushButton#launcherSettingsButton:focus {
    color: #FFFFFF;
    background-color: rgba(60, 60, 60, 200);
    border: 3px solid $theme_color;
}

QToolButton#launcherPowerButton {
    background-color: rgba(35, 35, 35, 140);
    color: #FFFFFF;
    font-size: 24px;
    font-weight: bold;
    border-radius: $border_radius;
    border: 2px solid rgba(255, 255, 255, 25);
}

QToolButton#launcherPowerButton:hover,
QToolButton#launcherPowerButton:focus {
    color: #FFFFFF;
    background-color: rgba(60, 60, 60, 200);
    border: 3px solid $theme_color;
}

QToolButton#launcherPowerButton:pressed,
QToolButton#launcherPowerButton:on,
QToolButton#launcherPowerButton:checked {
    background-color: rgba(35, 35, 35, 140);
    border: 2px solid rgba(255, 255, 255, 25);
}

QToolButton#launcherPowerButton::menu-indicator {
    width: 0px;
}

QToolButton#applicationTile {
    background-color: rgba(35, 35, 35, 140);
    color: #FFFFFF;
    font-size: 18px;
    font-weight: bold;
    border-radius: $border_radius;
    border: 2px solid rgba(255, 255, 255, 25);
    padding-top: 28px;
    padding-bottom: 15px;
}

QToolButton#applicationTile:hover,
QToolButton#applicationTile:focus {
    background-color: rgba(60, 60, 60, 200);
    border: 3px solid $theme_color;
}

QLabel#transitionProxy {
    background: transparent;
    border: none;
}

QLabel#soundDisplayTitle {
    color: #FFFFFF;
    font-size: 24px;
    font-weight: bold;
}

QLabel#soundDisplayDescription,
QLabel#soundDisplayStatus {
    color: #AAAAAA;
    font-size: 14px;
}

QLabel#soundDisplaySectionTitle {
    color: #FFFFFF;
    font-size: 18px;
    font-weight: bold;
}

QLabel#soundDisplayValue {
    color: #FFFFFF;
    font-size: 14px;
}

QFrame#soundDisplayCard {
    background-color: rgba(22, 22, 22, 200);
    border: 1px solid rgba(255, 255, 255, 30);
    border-radius: 8px;
}

QComboBox#soundDisplayControl {
    background-color: rgba(40, 40, 40, 220);
    color: #FFFFFF;
    padding: 8px 10px;
    border: 1px solid rgba(255, 255, 255, 35);
    border-radius: 4px;
}

QComboBox#soundDisplayControl:disabled {
    color: rgba(255, 255, 255, 100);
    background-color: rgba(40, 40, 40, 100);
}

QSlider#soundDisplaySlider::groove:horizontal {
    height: 6px;
    background: rgba(255, 255, 255, 45);
    border-radius: 3px;
}

QSlider#soundDisplaySlider::handle:horizontal {
    width: 16px;
    margin: -5px 0;
    background: $theme_color;
    border-radius: 8px;
}

/* Settings Panel Buttons - Consistent with launcher style */
QPushButton#soundDisplayButton {
    background-color: rgba(35, 35, 35, 160);
    color: #FFFFFF;
    padding: 10px 20px;
    border: 2px solid rgba(255, 255, 255, 30);
    border-radius: 12px;
    font-weight: bold;
    font-size: 14px;
}

QPushButton#soundDisplayButton:hover,
QPushButton#soundDisplayButton:focus {
    background-color: rgba(60, 60, 60, 210);
    border: 2px solid $theme_color;
}

QPushButton#soundDisplayButton:disabled {
    color: rgba(255, 255, 255, 80);
    background-color: rgba(35, 35, 35, 80);
    border: 2px solid rgba(255, 255, 255, 15);
}

/* Alternative: Smaller variant for compact spaces */
QPushButton#soundDisplayButtonSmall {
    background-color: rgba(45, 45, 45, 180);
    color: #FFFFFF;
    padding: 6px 12px;
    border: 1px solid rgba(255, 255, 255, 25);
    border-radius: 6px;
    font-weight: bold;
    font-size: 12px;
}

QPushButton#soundDisplayButtonSmall:hover,
QPushButton#soundDisplayButtonSmall:focus {
    background-color: rgba(65, 65, 65, 220);
    border: 1px solid $theme_color;
}

QPushButton#soundDisplayButtonSmall:disabled {
    color: rgba(255, 255, 255, 60);
    background-color: rgba(35, 35, 35, 60);
    border: 1px solid rgba(255, 255, 255, 10);
}

QCheckBox {
    color: #FFFFFF;
}

QListWidget#connectivityList {
    background-color: rgba(40, 40, 40, 160);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 30);
    border-radius: 4px;
    padding: 4px;
    font-size: 14px;
}

QListWidget#connectivityList::item {
    padding: 8px;
}

QListWidget#connectivityList::item:selected {
    background-color: $theme_color;
    color: #FFFFFF;
}

QTableWidget#taskTable {
    background-color: rgba(40, 40, 40, 160);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 30);
    border-radius: 4px;
    font-size: 14px;
    selection-background-color: $theme_color;
    selection-color: #FFFFFF;
}

QTableWidget#taskTable::item {
    padding: 6px;
}

QTableWidget#taskTable QHeaderView::section {
    background-color: rgba(30, 30, 30, 230);
    color: #CCCCCC;
    padding: 8px;
    border: none;
    font-weight: bold;
}
